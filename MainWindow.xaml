<Window x:Class="ZDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Z-Desk Controller" Icon="/ZDesk;component/Assets/ZDesk.ico"
        Width="1" Height="1" Left="-32000" Top="-32000"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False"
        AllowsTransparency="True" Background="Transparent" Opacity="0">
    <!-- The controller owns hooks, hotkeys and the tray icon. It never acts as a canvas. -->
    <Grid Visibility="Collapsed">
        <TextBlock x:Name="StatusText" />
        <Button x:Name="HideButton" />
        <Button x:Name="TopmostButton" />
        <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" />
        <Popup x:Name="SearchPopup" />
        <ListBox x:Name="SearchResults" MouseDoubleClick="SearchResults_MouseDoubleClick" />
    </Grid>
</Window>
