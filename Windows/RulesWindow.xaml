<Window x:Class="ZDesk.Windows.RulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自动归类规则" Width="980" Height="620" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource SettingsSurfaceBrush}" Foreground="{StaticResource SettingsTextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="62" /></Grid.RowDefinitions>
        <Border Background="{StaticResource SettingsTitleBarBrush}" BorderBrush="{StaticResource SettingsLineBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="23" Height="23" CornerRadius="12" Background="#FF0FC5E8"><TextBlock Text="Z" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="自动归类规则" Margin="10,0,0,0" FontSize="16" VerticalAlignment="Center" /></StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SettingsTitleButtonStyle}" ToolTip="最小化" Click="MinimizeButton_Click"><Path Stroke="#FFE6EAF2" StrokeThickness="1.2" Data="M1,6 L11,6" Width="12" Height="12" Stretch="None" /></Button>
                <Button Grid.Column="2" Style="{StaticResource SettingsTitleButtonStyle}" Content="×" Click="CloseButton_Click" />
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="22,18,22,14">
            <StackPanel Orientation="Horizontal"><Button Style="{StaticResource SettingsDialogButtonStyle}" Content="新增规则" Click="Add_Click" /><Button Style="{StaticResource SettingsDialogButtonStyle}" Content="移除规则" Click="Remove_Click" /><Button Style="{StaticResource SettingsDialogButtonStyle}" Content="预览" Click="Preview_Click" /><Button Style="{StaticResource SettingsDialogButtonStyle}" Content="执行预览结果" Click="Execute_Click" /></StackPanel>
        </Grid>
        <DataGrid x:Name="RulesGrid" Grid.Row="2" Margin="22,0" Style="{StaticResource SettingsDataGridStyle}"
                  ColumnHeaderStyle="{StaticResource SettingsDataGridHeaderStyle}" CellStyle="{StaticResource SettingsDataGridCellStyle}"
                  RowStyle="{StaticResource SettingsDataGridRowStyle}" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="55" />
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="125" />
                <DataGridTextColumn Header="来源文件夹" Binding="{Binding SourceFolder}" Width="*" />
                <DataGridTextColumn Header="扩展名" Binding="{Binding Extensions}" Width="110" />
                <DataGridTextColumn Header="名称包含" Binding="{Binding NameContains}" Width="100" />
                <DataGridTextColumn Header="排除名称" Binding="{Binding ExcludeNameContains}" Width="100" />
                <DataGridTextColumn Header="至少天数" Binding="{Binding MinimumAgeDays}" Width="75" />
                <DataGridTextColumn Header="目标文件夹" Binding="{Binding TargetFolder}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
        <Border Grid.Row="3" Margin="0,14,0,0" Background="{StaticResource SettingsTitleBarBrush}" BorderBrush="{StaticResource SettingsLineBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="22,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center"><TextBlock x:Name="StatusText" Foreground="{StaticResource SettingsMutedBrush}" /><TextBlock x:Name="HistoryText" Margin="0,3,0,0" Foreground="{StaticResource SettingsMutedBrush}" FontSize="10" /></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource SettingsDialogButtonStyle}" Content="关闭" IsCancel="True" /><Button Style="{StaticResource SettingsDialogButtonStyle}" Content="保存规则" Margin="0" IsDefault="True" Background="#FF3566B6" BorderBrush="#FF6F9CDD" Click="Save_Click" /></StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
