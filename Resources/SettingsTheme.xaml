<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="SettingsSurfaceBrush" Color="#FF1E1F26" />
    <SolidColorBrush x:Key="SettingsTitleBarBrush" Color="#FF171820" />
    <SolidColorBrush x:Key="SettingsSidebarBrush" Color="#FF1A1B22" />
    <SolidColorBrush x:Key="SettingsLineBrush" Color="#FF30313A" />
    <SolidColorBrush x:Key="SettingsTextBrush" Color="#FFF3F4F8" />
    <SolidColorBrush x:Key="SettingsMutedBrush" Color="#FFB5B6C1" />

    <Style x:Key="SettingsDialogButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="13,7" />
        <Setter Property="Background" Value="#0CFFFFFF" />
        <Setter Property="BorderBrush" Value="#35FFFFFF" />
        <Setter Property="Foreground" Value="{StaticResource SettingsTextBrush}" />
    </Style>
    <Style x:Key="SettingsTitleButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsDialogButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="13,6" />
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style x:Key="SettingsDataGridStyle" TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource SettingsSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource SettingsTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SettingsLineBrush}" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="AlternationCount" Value="2" />
    </Style>
    <Style x:Key="SettingsDataGridHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#FF292A32" />
        <Setter Property="Foreground" Value="#FFE7E8EE" />
        <Setter Property="BorderBrush" Value="#FF3B3C45" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="SettingsDataGridCellStyle" TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#FFE8E9EF" />
        <Setter Property="BorderBrush" Value="#253F414B" />
        <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style x:Key="SettingsDataGridRowStyle" TargetType="DataGridRow">
        <Setter Property="Background" Value="#FF202129" />
        <Setter Property="Foreground" Value="#FFE8E9EF" />
        <Style.Triggers>
            <Trigger Property="AlternationIndex" Value="1"><Setter Property="Background" Value="#FF24252D" /></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FF30313A" /></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#FF3A4D68" /></Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
