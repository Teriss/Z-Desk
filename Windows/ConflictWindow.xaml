<Window x:Class="ZDesk.Windows.ConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="同名项目处理" Width="500" Height="275" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="22"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="目标中存在同名项目" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="请选择本次任务遇到同名文件或目录时的处理方式。"
                       Margin="0,8,0,16" Foreground="{StaticResource MutedTextBrush}" />
            <RadioButton x:Name="RenameRadio" Content="自动重命名（推荐，不覆盖任何数据）" IsChecked="True" Margin="0,0,0,12" />
            <RadioButton x:Name="SkipRadio" Content="跳过所有同名项目" Margin="0,0,0,12" />
            <RadioButton x:Name="OverwriteRadio" Content="覆盖同名项目（不可撤销）" Foreground="#FF9A9A" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消任务" IsCancel="True" />
            <Button Content="继续" Margin="0" IsDefault="True" Click="Continue_Click" />
        </StackPanel>
    </Grid>
</Window>
