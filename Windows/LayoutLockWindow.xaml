<Window x:Class="ZDesk.Windows.LayoutLockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="锁定布局" Width="560" Height="520" MinWidth="460" MinHeight="380"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource SettingsSurfaceBrush}" Foreground="{StaticResource SettingsTextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="62" /></Grid.RowDefinitions>
        <Border Background="{StaticResource SettingsTitleBarBrush}" BorderBrush="{StaticResource SettingsLineBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="23" Height="23" CornerRadius="12" Background="#FF0FC5E8"><TextBlock Text="Z" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="锁定布局" Margin="10,0,0,0" FontSize="16" VerticalAlignment="Center" /></StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SettingsTitleButtonStyle}" Content="×" Click="CloseButton_Click" />
            </Grid>
        </Border>
        <StackPanel Grid.Row="1" Margin="22,18,22,12">
            <TextBlock Text="选择需要排除自动归类的布局" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="锁定布局后，重新应用规则不会移除、重新分配或修改该布局中已有内容。" Margin="0,6,0,12" Foreground="{StaticResource SettingsMutedBrush}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource SettingsDialogButtonStyle}" Content="全选" Click="SelectAll_Click" />
                <Button Style="{StaticResource SettingsDialogButtonStyle}" Content="全部取消" Click="ClearAll_Click" />
                <TextBlock x:Name="SelectionSummaryText" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource SettingsMutedBrush}" />
            </StackPanel>
        </StackPanel>
        <ListBox x:Name="LayoutOptionsList" Grid.Row="2" Margin="22,0" Background="{StaticResource SettingsSurfaceBrush}"
                 BorderBrush="{StaticResource SettingsLineBrush}" BorderThickness="1" Padding="8" />
        <Border Grid.Row="3" Margin="0,14,0,0" Background="{StaticResource SettingsTitleBarBrush}" BorderBrush="{StaticResource SettingsLineBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="22,0">
                <Button Style="{StaticResource SettingsDialogButtonStyle}" Content="取消" IsCancel="True" Click="CancelButton_Click" />
                <Button Style="{StaticResource SettingsDialogButtonStyle}" Content="确定" IsDefault="True" Margin="0" Background="#FF3566B6" BorderBrush="#FF6F9CDD" Click="SaveButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
