    <UserControl x:Class="ZDesk.Controls.GroupContainer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:local="clr-namespace:ZDesk.Controls"
             MinWidth="220" MinHeight="36"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             RenderTransformOrigin="0.5,0.5"
             AllowDrop="True"
             PreviewDragEnter="Group_PreviewDragEnter"
             PreviewDragOver="Group_PreviewDragOver"
             PreviewDragLeave="Group_PreviewDragLeave"
             Drop="Group_Drop"
             MouseEnter="Group_MouseEnter"
             MouseLeave="Group_MouseLeave">
    <UserControl.Resources>
        <Style x:Key="GroupTabButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="27" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="#AFC0C6CF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#2CFFFFFF" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Border x:Name="HoverSurface" Margin="1,0" Background="Transparent" />
                            <TextBlock Margin="{TemplateBinding Padding}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       Text="{TemplateBinding Content}"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" />
                            <Border BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverSurface" Property="Background" Value="#0FFFFFFF" />
                                <Setter Property="Foreground" Value="#FFF7F9FC" />
                                <Setter Property="BorderBrush" Value="#70FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverSurface" Property="Background" Value="#18FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GroupTabButtonActiveStyle"
               TargetType="Button"
               BasedOn="{StaticResource GroupTabButtonStyle}">
            <Setter Property="Foreground" Value="#FFF8FAFC" />
            <Setter Property="BorderBrush" Value="#FFE8EDF4" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="DetailsHeaderButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="#AFC0C7D0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#24FFFFFF" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HeaderSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderSurface" Property="Background" Value="#14FFFFFF" />
                                <Setter Property="Foreground" Value="#F0F5F7FA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HeaderSurface" Property="Background" Value="#20FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ItemsPanelTemplate x:Key="WrapFileItemsPanel">
            <local:VirtualizingWrapPanel
                ItemWidth="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=ViewItemWidth}"
                ItemHeight="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=ViewItemHeight}" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="StackFileItemsPanel">
            <VirtualizingStackPanel />
        </ItemsPanelTemplate>

        <DataTemplate x:Key="IconFileTemplate">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="{Binding IconSource}"
                       Width="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ViewIconSize}"
                       Height="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ViewIconSize}"
                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Center" />
                <Grid Margin="3,5,3,0">
                    <TextBlock x:Name="NameText" Text="{Binding Name}"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="10.5" TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
                    <TextBox x:Name="RenameBox" Text="{Binding Name, Mode=OneWay}"
                             Visibility="Collapsed" MinWidth="68" Padding="2,0"
                             FontSize="10.5" TextAlignment="Center"
                             KeyDown="RenameBox_KeyDown"
                             LostKeyboardFocus="RenameBox_LostKeyboardFocus" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="CompactFileTemplate">
            <Grid Margin="5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="{Binding IconSource}" Width="18" Height="18"
                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Left" VerticalAlignment="Center" />
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="NameText" Text="{Binding Name}"
                               Foreground="{StaticResource TextBrush}" FontSize="11"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
                    <TextBox x:Name="RenameBox" Text="{Binding Name, Mode=OneWay}"
                             Visibility="Collapsed" Padding="2,0" FontSize="11"
                             KeyDown="RenameBox_KeyDown"
                             LostKeyboardFocus="RenameBox_LostKeyboardFocus" />
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="DetailsFileTemplate">
            <Grid Margin="5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="4.5*" />
                    <ColumnDefinition Width="2.2*" />
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="1.1*" />
                </Grid.ColumnDefinitions>
                <Image Source="{Binding IconSource}" Width="18" Height="18"
                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Left" VerticalAlignment="Center" />
                <Grid Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="NameText" Text="{Binding Name}"
                               Foreground="{StaticResource TextBrush}" FontSize="11"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
                    <TextBox x:Name="RenameBox" Text="{Binding Name, Mode=OneWay}"
                             Visibility="Collapsed" Padding="2,0" FontSize="11"
                             KeyDown="RenameBox_KeyDown"
                             LostKeyboardFocus="RenameBox_LostKeyboardFocus" />
                </Grid>
                <TextBlock Grid.Column="2" Text="{Binding ModifiedText}" Foreground="#B8C4CAD3"
                           FontSize="10.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Text="{Binding TypeName}" Foreground="#B8C4CAD3"
                           FontSize="10.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="4" Text="{Binding SizeText}" Foreground="#B8C4CAD3"
                           FontSize="10.5" TextAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TileFileTemplate">
            <Grid Margin="7,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="{Binding IconSource}" Width="38" Height="38"
                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Left" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock x:Name="NameText" Text="{Binding Name}"
                                   Foreground="{StaticResource TextBrush}" FontSize="11.5"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
                        <TextBox x:Name="RenameBox" Text="{Binding Name, Mode=OneWay}"
                                 Visibility="Collapsed" Padding="2,0" FontSize="11.5"
                                 KeyDown="RenameBox_KeyDown"
                                 LostKeyboardFocus="RenameBox_LostKeyboardFocus" />
                    </Grid>
                    <TextBlock Text="{Binding TypeName}" Margin="0,3,0,0"
                               Foreground="#AAB8C0CA" FontSize="10" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SizeText}" Foreground="#8FAAB3BF" FontSize="10" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ContentFileTemplate">
            <Grid Margin="7,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="{Binding IconSource}" Width="32" Height="32"
                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Left" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock x:Name="NameText" Text="{Binding Name}"
                                   Foreground="{StaticResource TextBrush}" FontSize="11.5"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
                        <TextBox x:Name="RenameBox" Text="{Binding Name, Mode=OneWay}"
                                 Visibility="Collapsed" Padding="2,0" FontSize="11.5"
                                 KeyDown="RenameBox_KeyDown"
                                 LostKeyboardFocus="RenameBox_LostKeyboardFocus" />
                    </Grid>
                    <TextBlock Text="{Binding DetailSummary}" Margin="0,4,0,0"
                               Foreground="#AAB8C0CA" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.RenderTransform>
        <ScaleTransform x:Name="VisibilityScale" ScaleX="1" ScaleY="1" />
    </UserControl.RenderTransform>

    <Border x:Name="RootBorder"
            BorderBrush="#48FFFFFF"
            BorderThickness="1"
            CornerRadius="11"
            ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#EE252A33" Offset="0" />
                <GradientStop Color="#EA171B22" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow" Height="36" />
                <RowDefinition x:Name="ContentRow" Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="DragHeader"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown"
                    MouseMove="Header_MouseMove"
                    MouseLeftButtonUp="Header_MouseLeftButtonUp"
                    MouseRightButtonUp="Header_MouseRightButtonUp">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#3AFFFFFF" Offset="0" />
                        <GradientStop Color="#12FFFFFF" Offset="0.55" />
                        <GradientStop Color="#20FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid Margin="8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="TitleText" Grid.ColumnSpan="3"
                                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,7,0,0"
                                   Foreground="{StaticResource TextBrush}"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   MouseLeftButtonDown="TitleText_MouseLeftButtonDown" />
                        <TextBox x:Name="TitleRenameBox" Grid.ColumnSpan="3"
                                 Width="168" Height="25" Margin="0,4,0,0"
                                 HorizontalAlignment="Center" VerticalAlignment="Top"
                                 Visibility="Collapsed" Padding="5,1"
                                 Background="#F02B2D35" Foreground="White"
                                 BorderBrush="#FF6F9CDD" BorderThickness="1"
                                 FontSize="12" TextAlignment="Center"
                                 KeyDown="TitleRenameBox_KeyDown"
                                 LostKeyboardFocus="TitleRenameBox_LostKeyboardFocus" />
                        <primitives:UniformGrid x:Name="TabStrip"
                                                Grid.ColumnSpan="3"
                                                Rows="1"
                                                Height="27"
                                                Margin="15,0,15,1"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Bottom"
                                                Visibility="Collapsed" />
                        <TextBlock x:Name="PathText" Visibility="Collapsed" />

                        <Button Grid.Column="1" x:Name="OpenButton"
                                Style="{StaticResource GroupHeaderButtonStyle}"
                                VerticalAlignment="Top" Margin="1,5,0,0"
                                ToolTip="在资源管理器中打开" Click="OpenButton_Click">
                            <Viewbox Width="13" Height="13"><Path x:Name="OpenGlyph" Fill="{StaticResource TextBrush}" Data="M1,2 H9 L12,5 V12 H1 Z M2,3 V11 H11 V6 H7 L6,4 H2 Z" /></Viewbox>
                        </Button>
                        <Button Grid.Column="2" x:Name="CollapseButton"
                                Style="{StaticResource GroupHeaderButtonStyle}"
                                VerticalAlignment="Top" Margin="1,5,0,0"
                                ToolTip="折叠/展开" Click="CollapseButton_Click">
                            <Viewbox Width="13" Height="13"><Path x:Name="CollapseGlyph" Fill="{StaticResource TextBrush}" Data="M2,5 L6.5,9 L11,5 L12,6 L6.5,11 L1,6 Z" /></Viewbox>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <Grid x:Name="ContentPanel" Grid.Row="1" Margin="7,8,7,9">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border x:Name="DetailsHeader" Grid.Row="0" Height="30"
                        Margin="0,0,0,2" Background="#18FFFFFF"
                        BorderBrush="#2CFFFFFF" BorderThickness="0,0,0,1"
                        Visibility="Collapsed">
                    <Grid Margin="9,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="4.5*" />
                            <ColumnDefinition Width="2.2*" />
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="1.1*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="NameSortButton" Grid.Column="1" Tag="Name" Content="名称"
                                Style="{StaticResource DetailsHeaderButtonStyle}" Click="DetailsHeader_Click" />
                        <Button x:Name="ModifiedSortButton" Grid.Column="2" Tag="Modified" Content="修改日期"
                                Style="{StaticResource DetailsHeaderButtonStyle}" Click="DetailsHeader_Click" />
                        <Button x:Name="TypeSortButton" Grid.Column="3" Tag="Type" Content="类型"
                                Style="{StaticResource DetailsHeaderButtonStyle}" Click="DetailsHeader_Click" />
                        <Button x:Name="SizeSortButton" Grid.Column="4" Tag="Size" Content="大小"
                                HorizontalContentAlignment="Right" BorderThickness="0"
                                Style="{StaticResource DetailsHeaderButtonStyle}" Click="DetailsHeader_Click" />
                    </Grid>
                </Border>
                <ListBox x:Name="FileList"
                         Grid.Row="1"
                         Background="Transparent" BorderThickness="0"
                         SelectionMode="Extended"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown"
                         PreviewMouseLeftButtonUp="FileList_PreviewMouseLeftButtonUp"
                         PreviewMouseRightButtonDown="FileList_PreviewMouseRightButtonDown"
                         PreviewMouseMove="FileList_PreviewMouseMove"
                         PreviewKeyDown="FileList_PreviewKeyDown"
                         SelectionChanged="FileList_SelectionChanged"
                         PreviewMouseRightButtonUp="FileList_PreviewMouseRightButtonUp"
                         MouseDoubleClick="FileList_MouseDoubleClick">
                    <ListBox.ItemsPanel>
                        <StaticResource ResourceKey="WrapFileItemsPanel" />
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <EventSetter Event="Loaded" Handler="FileItem_Loaded" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="2" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemSurface"
                                                Width="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ViewItemWidth}"
                                                Height="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ViewItemHeight}"
                                                Padding="2"
                                                HorizontalAlignment="Stretch"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemSurface" Property="Background" Value="#20FFFFFF" />
                                                <Setter TargetName="ItemSurface" Property="BorderBrush" Value="#2EFFFFFF" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemSurface" Property="Background" Value="#3566B6FF" />
                                                <Setter TargetName="ItemSurface" Property="BorderBrush" Value="#7066B6FF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <StaticResource ResourceKey="IconFileTemplate" />
                    </ListBox.ItemTemplate>
                </ListBox>

                <Rectangle x:Name="IconSelectionRectangle" Grid.Row="1" Visibility="Collapsed"
                           Fill="#2466B6FF" Stroke="#A066B6FF" StrokeThickness="1"
                           HorizontalAlignment="Left" VerticalAlignment="Top"
                           IsHitTestVisible="False" />

                <StackPanel x:Name="EmptyMessagePanel" Grid.Row="1"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="19"
                            Background="#16FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1"
                            HorizontalAlignment="Center">
                        <TextBlock Text="＋" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="EmptyMessage"
                               Margin="0,9,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="空分组 · 文件夹映射将在这里显示内容"
                               FontSize="11" TextAlignment="Center" />
                </StackPanel>
            </Grid>

            <primitives:Thumb x:Name="ResizeThumb"
                              Grid.RowSpan="2" Width="22" Height="22"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              Cursor="SizeNWSE" Background="Transparent"
                              DragStarted="ResizeGrip_DragStarted"
                              DragDelta="ResizeGrip_DragDelta"
                              DragCompleted="ResizeGrip_DragCompleted">
                <primitives:Thumb.Template>
                    <ControlTemplate TargetType="primitives:Thumb">
                        <Grid Background="Transparent">
                            <Path Data="M 8,18 L 18,8 M 13,18 L 18,13"
                                  Stroke="#75FFFFFF" StrokeThickness="1.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>
                    </ControlTemplate>
                </primitives:Thumb.Template>
            </primitives:Thumb>

            <Border x:Name="DropOverlay" Grid.RowSpan="2"
                    Margin="5" CornerRadius="9"
                    Background="#E6172535"
                    BorderBrush="#B066B6FF" BorderThickness="1.5"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="46" Height="46" CornerRadius="23"
                            Background="#3066B6FF" BorderBrush="#7866B6FF" BorderThickness="1">
                        <TextBlock x:Name="DropGlyph" Text="＋" FontSize="24"
                                   Foreground="#EAF5FF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="DropTitle" Margin="0,12,0,0"
                               Text="复制到此分组"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="DropSubtitle" Margin="0,4,0,0"
                               Text="按住 Shift 可移动"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10.5" HorizontalAlignment="Center" />
                    <ProgressBar x:Name="TransferProgress"
                                 Width="150" Height="3" Margin="0,13,0,0"
                                 IsIndeterminate="True" Visibility="Collapsed"
                                 Foreground="{StaticResource AccentBrush}"
                                 Background="#20FFFFFF" />
                    <Button x:Name="CancelTransferButton" Content="取消任务" Margin="0,12,0,0"
                            Visibility="Collapsed" Click="CancelTransferButton_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
