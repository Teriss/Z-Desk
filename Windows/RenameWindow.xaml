<Window x:Class="ZDesk.Windows.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重命名" Width="420" Height="170" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="输入新名称" FontWeight="SemiBold" />
            <TextBox x:Name="NameTextBox" Margin="0,10,0,0" Padding="8,5"
                     Background="#18FFFFFF" Foreground="{StaticResource TextBrush}" BorderBrush="#48FFFFFF" />
            <TextBlock x:Name="ErrorText" Margin="0,6,0,0" Foreground="#FF8A8A" FontSize="10" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" />
            <Button Content="确定" IsDefault="True" Margin="0" Click="Confirm_Click" />
        </StackPanel>
    </Grid>
</Window>
