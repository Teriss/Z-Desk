<Window x:Class="ZDesk.Windows.DesktopSurfaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        AllowsTransparency="True" Background="#01000000"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid x:Name="Surface"
          Background="#01000000"
          AllowDrop="True"
          PreviewDragOver="Surface_PreviewDragOver"
          Drop="Surface_Drop"
          PreviewMouseLeftButtonDown="Surface_MouseLeftButtonDown"
          PreviewMouseRightButtonDown="Surface_MouseRightButtonDown"
          PreviewMouseMove="Surface_MouseMove"
          PreviewMouseLeftButtonUp="Surface_MouseButtonUp"
          PreviewMouseRightButtonUp="Surface_MouseButtonUp">
        <ListBox x:Name="IconList"
                 Background="Transparent" BorderThickness="0"
                 SelectionMode="Extended"
                 PreviewMouseLeftButtonDown="IconList_MouseLeftButtonDown"
                 PreviewMouseMove="IconList_MouseMove"
                 PreviewMouseRightButtonUp="IconList_MouseRightButtonUp"
                 PreviewKeyDown="IconList_KeyDown"
                 MouseDoubleClick="IconList_MouseDoubleClick">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                    <Setter Property="Width" Value="88" />
                    <Setter Property="Height" Value="82" />
                    <Setter Property="Padding" Value="3" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="#2678B9FF" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="#4978B9FF" />
                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#A078B9FF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel HorizontalAlignment="Center">
                        <Image Source="{Binding Entry.IconSource}" Width="38" Height="38" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Entry.Name}" Margin="0,4,0,0" MaxWidth="82"
                                   Foreground="White" FontSize="11" TextAlignment="Center"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.9" />
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Rectangle x:Name="SelectionRectangle" Visibility="Collapsed"
                   Fill="#2478B9FF" Stroke="#B078B9FF" StrokeThickness="1"
                   HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
    </Grid>
</Window>
