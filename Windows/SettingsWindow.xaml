<Window x:Class="ZDesk.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ZDesk.Models"
        Title="Z-Desk 设置" Width="1020" Height="700" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#FF1E1F26"
        Foreground="#FFF3F7FF" FontFamily="Segoe UI Variable Text, Segoe UI"
        ResizeMode="CanResizeWithGrip" WindowStyle="None" Icon="/ZDesk;component/Assets/ZDesk.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FF1E1F26" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#FF30313A" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FFB5B6C1" />
        <SolidColorBrush x:Key="ControlSurfaceBrush" Color="#FF24262E" />
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#FF40434F" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF4A82D8" />
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Foreground" Value="#FFF4F7FC" />
            <Setter Property="Background" Value="#0CFFFFFF" />
            <Setter Property="BorderBrush" Value="#2AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#20FFFFFF" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#3A66B6FF" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.42" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="52" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFF3F7FF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="#FF1B1D24" BorderBrush="#FF686D7A" BorderThickness="1" CornerRadius="3">
                                <Path x:Name="Check" Visibility="Collapsed" Stroke="White" StrokeThickness="1.8"
                                      Data="M2,7 L5.5,10.5 L12.5,3.5" Stretch="Uniform" Margin="2" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" /><Setter TargetName="Box" Property="BorderBrush" Value="#FF78A6EA" /><Setter TargetName="Check" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#FF8A91A0" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModeRadioCardStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFF3F7FF" />
            <Setter Property="Background" Value="{StaticResource ControlSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border x:Name="Ring" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="#FF191B21" BorderBrush="#FF737987" BorderThickness="1" CornerRadius="8">
                                    <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource AccentBrush}" Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#FF2B2E38" /><Setter TargetName="Card" Property="BorderBrush" Value="#FF596071" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="Background" Value="#FF26364D" /><Setter TargetName="Card" Property="BorderBrush" Value="#FF5F91D9" /><Setter TargetName="Dot" Property="Visibility" Value="Visible" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="#19000000" />
            <Setter Property="Foreground" Value="#FFF3F7FF" />
            <Setter Property="BorderBrush" Value="#3DFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Background" Value="#FF292A32" />
            <Setter Property="Foreground" Value="#FFF3F4F8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="#FF4A4B56" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="26" /></Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                                    <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#FFD7D9E0" Data="M 0 0 L 7 0 L 3.5 4 Z" />
                                </Grid>
                            </ToggleButton>
                            <Popup x:Name="Popup" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade" IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border MinWidth="{Binding ActualWidth, ElementName=ToggleButton}" MaxHeight="260" Background="#FF292A32" BorderBrush="#FF555763" BorderThickness="1">
                                    <ScrollViewer CanContentScroll="True" Padding="2"><StackPanel IsItemsHost="True" /></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleButton" Property="Background" Value="#FF363741" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FFF3F4F8" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#FF3A4D68" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#FF3566B6" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="9" />
            <Setter Property="Background" Value="#FF1A1B22" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="#FF1A1B22" Padding="2,3,2,3">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=ScrollBar}}" Background="Transparent" BorderThickness="0" /></Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Background="#FF606674" BorderBrush="#FF747B89" BorderThickness="1">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="#FF7A8291" /></Trigger>
                                                    <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="#FF8A93A3" /></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=ScrollBar}}" Background="Transparent" BorderThickness="0" /></Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal"><Setter Property="Height" Value="9" /><Setter Property="Width" Value="Auto" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="NavItem" Background="Transparent" CornerRadius="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavItem" Property="Background" Value="#15FFFFFF" /></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavItem" Property="Background" Value="#FF52535C" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#FF202129" />
            <Setter Property="BorderBrush" Value="#FF353741" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
        <Style x:Key="RuleTypeBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF343641" />
            <Setter Property="BorderBrush" Value="#FF555967" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding FoldersOnly}" Value="True">
                    <Setter Property="Background" Value="#FF294C62" />
                    <Setter Property="BorderBrush" Value="#FF4C89AD" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ApplicationsOnly}" Value="True">
                    <Setter Property="Background" Value="#FF31523D" />
                    <Setter Property="BorderBrush" Value="#FF5B9A70" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PathContains, TargetNullValue=''}" Value="steam;steamapps;epic;gog;riot;ubisoft;ea app;battle.net">
                    <Setter Property="Background" Value="#FF493B63" />
                    <Setter Property="BorderBrush" Value="#FF8069B0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGrid" BasedOn="{StaticResource SettingsDataGridStyle}">
            <Setter Property="Background" Value="#FF1B1D24" />
            <Setter Property="RowBackground" Value="#FF202129" />
            <Setter Property="AlternatingRowBackground" Value="#FF24262E" />
            <Setter Property="HorizontalGridLinesBrush" Value="#FF343741" />
            <Setter Property="VerticalGridLinesBrush" Value="#FF343741" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#FF1B1D24" />
            <Setter Property="Foreground" Value="#FFF3F4F8" />
            <Setter Property="BorderBrush" Value="#FF40434F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FF292A32" />
            <Setter Property="Foreground" Value="#FFE7E8EE" />
            <Setter Property="BorderBrush" Value="#FF3B3C45" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFE8E9EF" />
            <Setter Property="BorderBrush" Value="#253F414B" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#FF202129" />
            <Setter Property="Foreground" Value="#FFE8E9EF" />
            <Setter Property="BorderBrush" Value="#263F414B" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1"><Setter Property="Background" Value="#FF24252D" /></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FF30313A" /></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#FF3A4D68" /></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="*" /><RowDefinition Height="54" /></Grid.RowDefinitions>
        <Border Background="#FF171820" BorderBrush="#FF2B2C34" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="23" Height="23" CornerRadius="12" Background="#FF0FC5E8"><TextBlock Text="Z" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="设置中心" Margin="10,0,0,0" FontSize="16" VerticalAlignment="Center" /></StackPanel>
                <Button Grid.Column="1" Style="{StaticResource CaptionButtonStyle}" ToolTip="最小化" Click="MinimizeButton_Click"><Path Stroke="#FFE6EAF2" StrokeThickness="1.2" Data="M1,6 L11,6" Width="12" Height="12" Stretch="None" /></Button>
                <Button Grid.Column="2" Style="{StaticResource CaptionButtonStyle}" ToolTip="关闭" Click="CloseButton_Click"><Path Fill="#FFE6EAF2" Data="M2,2 L14,14 M14,2 L2,14" Width="12" Height="12" Stretch="Fill" Stroke="#FFE6EAF2" StrokeThickness="1.4" /></Button>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="#FF1E1F26" BorderBrush="Transparent" BorderThickness="0" CornerRadius="0" ClipToBounds="True">
            <TabControl Background="Transparent" BorderThickness="0" Padding="0">
                <TabControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Vertical" /></ItemsPanelTemplate></TabControl.ItemsPanel>
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Background="#FF1A1B22" BorderBrush="#FF30313A" BorderThickness="0,0,1,0">
                                <Grid Margin="16,18">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                                    <TextBlock Grid.Row="2" Text="设置会在应用后立即生效" FontSize="10.5" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                                </Grid>
                            </Border>
                            <Grid Grid.Column="1" Margin="44,30,8,24">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>
                <TabItem Header="常规">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                        <TextBlock Text="常规" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="控制桌面容器的基础行为" Margin="0,4,0,22" Foreground="{StaticResource MutedBrush}" />
                        <Border Style="{StaticResource SectionCard}"><StackPanel>
                            <TextBlock Text="桌面交互" FontWeight="SemiBold" Margin="0,0,0,16" />
                            <CheckBox x:Name="DoubleClickCheckBox" Content="双击桌面空白区域隐藏或显示分组" />
                            <CheckBox x:Name="RememberHiddenCheckBox" Content="记住分组隐藏状态" />
                            <CheckBox x:Name="DisplayProfilesCheckBox" Content="按显示器组合自动切换布局" Margin="0" />
                            <TextBlock Text="贴边行为" FontWeight="SemiBold" Margin="0,22,0,10" />
                            <RadioButton x:Name="StandardModeRadio" GroupName="InteractionMode" Style="{StaticResource ModeRadioCardStyle}">
                                <StackPanel><TextBlock Text="标准吸附" FontWeight="SemiBold" Foreground="#FFF3F7FF" /><TextBlock Text="布局贴近屏幕边缘时吸附，保持完整显示。" Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" /></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="EdgeHideModeRadio" GroupName="InteractionMode" Style="{StaticResource ModeRadioCardStyle}" Margin="0">
                                <StackPanel><TextBlock Text="贴边隐藏（QQ 模式）" FontWeight="SemiBold" Foreground="#FFF3F7FF" /><TextBlock Text="贴到左、右或上边缘后自动收起，所有布局始终置顶，鼠标靠近对应边缘时展开。" Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" /></StackPanel>
                            </RadioButton>
                        </StackPanel></Border>
                    </StackPanel></ScrollViewer>
                </TabItem>
                <TabItem Header="外观">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                        <TextBlock Text="外观" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="拖动滑块即可实时预览容器变化" Margin="0,4,0,22" Foreground="{StaticResource MutedBrush}" />
                        <Border Style="{StaticResource SectionCard}"><StackPanel>
                            <CheckBox x:Name="AnimationsCheckBox" Content="启用分组缓动动画" Checked="AppearanceControl_Changed" Unchecked="AppearanceControl_Changed" />
                            <TextBlock Text="容器不透明度" FontWeight="SemiBold" /><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions><Slider x:Name="OpacitySlider" Minimum="55" Maximum="100" ValueChanged="OpacitySlider_ValueChanged" /><TextBlock x:Name="OpacityValueText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" /></Grid>
                            <TextBlock Text="容器圆角" Margin="0,20,0,0" FontWeight="SemiBold" /><Slider x:Name="CornerSlider" Minimum="0" Maximum="24" Margin="0,8,58,0" ValueChanged="AppearanceControl_Changed" />
                            <TextBlock Text="图标密度" Margin="0,20,0,0" FontWeight="SemiBold" /><Slider x:Name="IconSizeSlider" Minimum="68" Maximum="112" Margin="0,8,58,0" ValueChanged="AppearanceControl_Changed" />
                            <TextBlock Text="动画速度" Margin="0,20,0,0" FontWeight="SemiBold" /><Slider x:Name="AnimationSpeedSlider" Minimum="0.5" Maximum="2" Margin="0,8,58,0" ValueChanged="AppearanceControl_Changed" />
                        </StackPanel></Border>
                    </StackPanel></ScrollViewer>
                </TabItem>
                <TabItem Header="快捷键">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                        <TextBlock Text="快捷键" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="二维码识别可在任何贴边模式下使用；布局置顶快捷键仅在标准吸附模式下生效。" Margin="0,4,0,18" Foreground="{StaticResource MutedBrush}" />
                        <Border Style="{StaticResource SectionCard}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="二维码识别" FontWeight="SemiBold" />
                                <TextBlock Text="录制全局快捷键后，框选屏幕区域即可识别其中全部二维码。未设置时不会注册快捷键。" Margin="0,5,0,12" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="QrRecognitionHotKeyTextBox" Height="38" IsReadOnly="True" VerticalContentAlignment="Center" PreviewKeyDown="QrRecognitionHotKeyTextBox_PreviewKeyDown" />
                                    <Button Grid.Column="1" Content="清除" Margin="8,0,0,0" Click="ClearQrRecognitionHotKey_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border x:Name="HotKeySettingsCard" Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="贴边隐藏（QQ 模式）下快捷键不生效" Margin="0,0,0,10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                <DockPanel><TextBlock Text="快捷键列表" FontWeight="SemiBold" VerticalAlignment="Center" /><Button DockPanel.Dock="Right" Content="删除所选" Margin="8,0,0,0" Click="DeleteHotKey_Click" /><Button DockPanel.Dock="Right" Content="＋ 添加快捷键" Margin="0" Click="AddHotKey_Click" /></DockPanel>
                                <TextBlock Text="选择一条快捷键后，在下方录制按键并设置目标布局。" Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                <DataGrid x:Name="HotKeysGrid" Height="116" Margin="0,10,0,18" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False" HeadersVisibility="Column" SelectionChanged="HotKeysGrid_SelectionChanged">
                                    <DataGrid.Columns><DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled, Mode=TwoWay}" Width="70" /><DataGridTextColumn Header="快捷键" Binding="{Binding Gesture, UpdateSourceTrigger=PropertyChanged}" Width="*" /></DataGrid.Columns>
                                </DataGrid>
                                <Border Background="#FF1B1D24" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="录制当前快捷键" FontWeight="SemiBold" />
                                        <TextBox x:Name="HotKeyTextBox" Margin="0,8,0,0" Height="38" IsReadOnly="True" VerticalContentAlignment="Center" PreviewKeyDown="HotKeyTextBox_PreviewKeyDown" />
                                        <CheckBox x:Name="HotKeyAllLayoutsCheckBox" Content="全部布局（包含以后新建的布局）" Margin="0,14,0,0" Checked="HotKeyTargetMode_Changed" Unchecked="HotKeyTargetMode_Changed" />
                                        <StackPanel x:Name="HotKeyTargetSelectionPanel" Margin="0,10,0,0">
                                            <TextBlock Text="目标布局" FontWeight="SemiBold" />
                                            <TextBlock Text="可以同时选择多个布局；组合布局中的子页签也可独立选择。" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,7" />
                                            <ListBox x:Name="HotKeyTargetsList" Height="150">
                                                <ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding Title}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Checked="HotKeyTarget_Changed" Unchecked="HotKeyTarget_Changed" Padding="4,3" Margin="0,0,0,3" /></DataTemplate></ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="HotKeyErrorText" Margin="0,10,0,0" Foreground="#FFFF9999" TextWrapping="Wrap" />
                                <TextBlock Text="按一次后选中布局置顶，再按一次恢复到桌面底层。" Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel></ScrollViewer>
                </TabItem>
                <TabItem Header="自动归类">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0,0,0,16">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="520" /></Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="自动归类规则" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="锁定布局后，重新应用规则不会移除、重新分配或修改该布局中已有内容。" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                    <TextBlock x:Name="LockedLayoutSummaryText" Margin="0,8,12,0" Foreground="{StaticResource MutedBrush}" />
                                    <Button Content="锁定布局" Click="LockLayouts_Click" />
                                    <Button Content="立即重新归类桌面" Background="#FF3566B6" BorderBrush="#FF6F9CDD" Margin="0" Click="ReapplyLayoutRules_Click" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="预设只改变桌面图标的布局归属，不会移动真实文件；列表越靠上优先级越高。扩展名非空自动匹配文件，目录规则由目录预设确定；路径关键词与扩展名需同时满足。" Margin="0,8,0,9" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                        <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button Content="＋ 添加规则" Click="AddBlankLayoutRule_Click" />
                                <Button Content="＋ 添加预设规则 ▾" Click="AddLayoutRulePresetMenu_Click" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Content="上移" Click="MoveLayoutRuleUp_Click" />
                                <Button Content="下移" Click="MoveLayoutRuleDown_Click" />
                                <Button Content="删除规则" Margin="0" Click="DeleteLayoutRule_Click" />
                            </StackPanel>
                        </DockPanel>
                            <Expander Header="自动刷新" Margin="0,7,0,0" Foreground="{StaticResource MutedBrush}"><WrapPanel Margin="18,8,0,2" VerticalAlignment="Center"><CheckBox x:Name="AutoRulesCheckBox" Content="定时应用规则" Margin="0,0,16,0" VerticalAlignment="Center" /><CheckBox x:Name="WatchRulesCheckBox" Content="桌面新增项目时应用" Margin="0,0,16,0" VerticalAlignment="Center" /><TextBlock Text="间隔（分钟）" VerticalAlignment="Center" /><TextBox x:Name="RuleIntervalTextBox" Width="54" Margin="7,0,0,0" Padding="7,4" VerticalContentAlignment="Center" /></WrapPanel></Expander>
                        </StackPanel>
                        <DataGrid x:Name="LayoutRulesGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False" CanUserReorderColumns="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" AlternationCount="2" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0" Background="#FF1E1F26" Foreground="#FFE8E9EF" BorderBrush="#FF3B3C45" AllowDrop="True" PreviewDragOver="LayoutRulesGrid_PreviewDragOver" Drop="LayoutRulesGrid_Drop">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="顺序" Width="58"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="⋮⋮" ToolTip="拖动以调整匹配顺序" Tag="{Binding}" Padding="5,2" PreviewMouseLeftButtonDown="RuleDragHandle_PreviewMouseLeftButtonDown" PreviewMouseMove="RuleDragHandle_PreviewMouseMove" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="52" />
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="120" />
                                <DataGridTemplateColumn Header="匹配类型" Width="124"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox Style="{StaticResource DarkComboBoxStyle}" ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}" ItemsSource="{Binding LayoutRuleTypeChoices, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Title" SelectedValuePath="Value" SelectedValue="{Binding EditorMatchType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" Foreground="#FFF3F4F8" FontWeight="SemiBold" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="目标普通布局" Width="170"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox Style="{StaticResource DarkComboBoxStyle}" ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}" ItemsSource="{Binding NormalLayoutChoices, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Title" SelectedValuePath="Id" SelectedValue="{Binding GroupId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" Foreground="#FFF3F4F8" FontWeight="SemiBold" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                 <DataGridTemplateColumn Header="扩展名" Width="220"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Extensions, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding CanEditCriteria, Converter={StaticResource BoolToVisibility}}" Padding="6,3" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                 <DataGridTemplateColumn Header="路径关键词（可选）" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding PathContains, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding CanEditCriteria, Converter={StaticResource BoolToVisibility}}" Padding="6,3" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="启动"><StackPanel><TextBlock Text="启动" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="控制登录 Windows 后的行为" Margin="0,4,0,22" Foreground="{StaticResource MutedBrush}" /><Border Style="{StaticResource SectionCard}"><StackPanel><CheckBox x:Name="StartWithWindowsCheckBox" Content="登录 Windows 后自动启动 Z-Desk" /><TextBlock Text="开机启动只写入当前用户配置，不需要管理员权限。" FontSize="11" Foreground="{StaticResource MutedBrush}" /></StackPanel></Border></StackPanel></TabItem>
                <TabItem Header="存储"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="存储" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="修改后会自动迁移现有数据" Margin="0,4,0,22" Foreground="{StaticResource MutedBrush}" /><Border Style="{StaticResource SectionCard}"><StackPanel><TextBlock Text="应用数据目录" FontWeight="SemiBold" /><Grid Margin="0,8,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="DataDirectoryTextBox" MinWidth="360" /><Button Grid.Column="1" Content="浏览..." Margin="8,0,0,0" Click="BrowseDataDirectory_Click" /></Grid><TextBlock Text="日志目录" FontWeight="SemiBold" /><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="LogDirectoryTextBox" MinWidth="360" /><Button Grid.Column="1" Content="浏览..." Margin="8,0,0,0" Click="BrowseLogDirectory_Click" /></Grid></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
                <TabItem Header="恢复"><StackPanel><TextBlock Text="恢复" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="布局快照不会修改真实文件" Margin="0,4,0,22" Foreground="{StaticResource MutedBrush}" /><Border Style="{StaticResource SectionCard}"><StackPanel><TextBlock Text="布局备份" FontWeight="SemiBold" /><TextBlock Text="每次保存前都会保留上一份有效布局。" Margin="0,8,0,16" FontSize="11" Foreground="{StaticResource MutedBrush}" /><Button Content="恢复上一份布局" HorizontalAlignment="Left" Click="RestoreBackupButton_Click" /></StackPanel></Border></StackPanel></TabItem>
            </TabControl>
        </Border>
        <Border Grid.Row="2" Background="#FF191A21" BorderBrush="#FF30313A" BorderThickness="0,1,0,0"><Grid Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Grid.Column="0" Content="退出 Z-Desk" Foreground="#FFFFA0A0" Click="ExitApplication_Click" /><TextBlock Grid.Column="1" x:Name="GeneralErrorText" Margin="14,0" Foreground="#FFFF9999" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="取消" Click="CancelButton_Click" /><Button x:Name="ApplyButton" Content="应用" IsEnabled="False" Background="#FF3566B6" BorderBrush="#FF6F9CDD" Click="ApplyButton_Click" /><Button Content="确定" Margin="0" IsDefault="True" Background="#FF3566B6" BorderBrush="#FF6F9CDD" Click="SaveButton_Click" /></StackPanel></Grid></Border>
    </Grid>
</Window>
