<Window x:Class="ZDesk.Windows.SnapshotsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="布局快照" Width="520" Height="420"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBackgroundBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal"><TextBox x:Name="NameBox" Width="260" Padding="8,5" Text="我的布局"/><Button Content="创建快照" Margin="8,0,0,0" Click="Create_Click"/></StackPanel>
        <ListBox x:Name="SnapshotList" Grid.Row="1" Margin="0,14" DisplayMemberPath="Name" Background="#10FFFFFF" Foreground="{StaticResource TextBrush}"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="关闭" IsCancel="True"/><Button Content="恢复所选" Margin="0" Click="Restore_Click"/></StackPanel>
    </Grid>
</Window>
