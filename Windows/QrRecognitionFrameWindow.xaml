<Window x:Class="ZDesk.Windows.QrRecognitionFrameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowActivated="True" UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#FFCCCCCC" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#FF2A2D2E" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#FF3E4244" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#FF3A3D3F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RecognizeButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Setter Property="Width" Value="62" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="Background" Value="#FF007ACC" />
            <Setter Property="BorderBrush" Value="#FF1688D0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#FF1A8AD1" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#FF0064A6" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Resize hit zones are intentionally invisible; the continuous border is the only frame chrome. -->
        <Style x:Key="InvisibleResizeThumb" TargetType="Thumb">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent" BorderThickness="0" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="Root" Background="Transparent">
        <Grid x:Name="CaptureRoot" Margin="0,34,0,0" Background="Transparent">
            <Border BorderBrush="#FF007ACC" BorderThickness="1" Background="Transparent" IsHitTestVisible="False" />
            <Thumb Style="{StaticResource InvisibleResizeThumb}" Width="12" HorizontalAlignment="Left" Cursor="SizeWE" Tag="Left"
                   DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted" />
            <Thumb Style="{StaticResource InvisibleResizeThumb}" Width="12" HorizontalAlignment="Right" Cursor="SizeWE" Tag="Right"
                   DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted" />
            <Thumb Style="{StaticResource InvisibleResizeThumb}" Height="12" VerticalAlignment="Top" Cursor="SizeNS" Tag="Top"
                   DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted" />
            <Thumb Style="{StaticResource InvisibleResizeThumb}" Height="12" VerticalAlignment="Bottom" Cursor="SizeNS" Tag="Bottom"
                   DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted" />
            <Thumb Style="{StaticResource InvisibleResizeThumb}" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" Tag="TopLeft"
                   DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted" />
            <Thumb Style="{StaticResource InvisibleResizeThumb}" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" Tag="TopRight"
                   DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted" />
            <Thumb Style="{StaticResource InvisibleResizeThumb}" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" Tag="BottomLeft"
                   DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted" />
            <Thumb Style="{StaticResource InvisibleResizeThumb}" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Tag="BottomRight"
                   DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted" />
        </Grid>
        <Border x:Name="TitleBar" Height="34" VerticalAlignment="Top" Background="#FF181818" BorderBrush="#FF3E3E42" BorderThickness="1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="6,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="62" />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Viewbox Width="15" Height="15" Margin="0,0,7,0">
                        <Path Fill="#FF4FC1FF" Data="M2,2 H6 V3.5 H3.5 V6 H2 Z M10,2 H14 V6 H12.5 V3.5 H10 Z M2,10 H3.5 V12.5 H6 V14 H2 Z M12.5,10 H14 V14 H10 V12.5 H12.5 Z M6,6 H10 V10 H6 Z M7.5,7.5 H8.5 V8.5 H7.5 Z" />
                    </Viewbox>
                    <TextBlock Text="二维码识别" Foreground="#FFCCCCCC" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="SizeText" Grid.Column="1" Foreground="#FF9D9D9D" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="11"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" />
                <Button x:Name="RecognizeButton" Grid.Column="2" Style="{StaticResource RecognizeButtonStyle}" ToolTip="识别二维码 (Enter)"
                        Click="RecognizeButton_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Viewbox Width="13" Height="13" Margin="0,0,4,0"><Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Data="M1,5 V1 H5 V2.5 H2.5 V5 Z M9,1 H13 V5 H11.5 V2.5 H9 Z M1,9 H2.5 V11.5 H5 V13 H1 Z M11.5,9 H13 V13 H9 V11.5 H11.5 Z M5,5 H9 V9 H5 Z" /></Viewbox>
                        <TextBlock Text="识别" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="CloseButton" Grid.Column="3" Style="{StaticResource TitleBarButton}" ToolTip="退出取景框 (Esc)"
                        Click="CloseButton_Click">
                    <Viewbox Width="13" Height="13"><Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        Data="M2,1 L7,6 L12,1 L13,2 L8,7 L13,12 L12,13 L7,8 L2,13 L1,12 L6,7 L1,2 Z" /></Viewbox>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
